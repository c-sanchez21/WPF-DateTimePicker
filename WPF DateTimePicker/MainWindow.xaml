<Window x:Class="WPF_DateTimePicker.Demo.MainWindow"        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:dtp="clr-namespace:WPF_DateTimePickerControl;assembly=WPF-DateTimePickerControl"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_DateTimePicker"
        mc:Ignorable="d"
        Title="DateTimePicker Demo" Height="500" Width="550" 
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Name="this">
    <Window.Resources>
        <!-- Minimalist styling for the demo elements -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="WPF Custom DateTimePicker" FontSize="20" FontWeight="SemiBold" 
                   Margin="0,0,0,15" Foreground="White" HorizontalAlignment="Center"/>

        <!-- Interactive Control Demo -->
        <GroupBox Grid.Row="1" Header="Interactive Control">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Select Date &amp; Time:" VerticalAlignment="Center" Margin="0,0,15,0"/>

                <!-- Custom Control (WPF-DateTimePickerControl) -->
                <dtp:DateTimePicker Grid.Column="1" VerticalAlignment="Center" Height="26"
                                    SelectedDate="{Binding MyDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </GroupBox>

        <!-- Live Data Binding Feedback -->
        <GroupBox Grid.Row="2" Header="Data Binding Verification">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock Text="Currently Bound Value (MyDate Property):" 
                           Foreground="#9E9E9E" FontSize="12" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding Path=MyDate, StringFormat='{}{0:yyyy-MMM-dd ddd HH:mm:ss}'}" 
                           FontSize="18" FontWeight="Bold" Foreground="#4DA8DA" HorizontalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <!-- Action Button -->
        <Button Grid.Row="3" Margin="0,10,0,0" Padding="15,6" HorizontalAlignment="Right"
                Background="#3F3F46" Foreground="White" BorderThickness="0" Cursor="Hand"
                Name="btnDisplayDate" Click="btnDisplayDate_Click" Content="Show Alert"/>
    </Grid>
</Window>
    
