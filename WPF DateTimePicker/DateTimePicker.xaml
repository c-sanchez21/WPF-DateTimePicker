<UserControl x:Class="WPF_DateTimePicker.DateTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_DateTimePicker"
             mc:Ignorable="d"
             d:DesignHeight ="30" d:DesignWidth ="200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="txtDateTime" 
                 Grid.Column="0"
                 VerticalContentAlignment="Center"
                 Padding="4,0,0,0"
                 PreviewMouseUp="txtDateTime_PreviewMouseUp"
                 PreviewKeyDown="txtDateTime_PreviewKeyDown"                 
                 LostFocus="txtDateTime_LostFocus"/>
        <ToggleButton x:Name="CalendarButton"
                      Grid.Column="1"
                      Width="30">
            <TextBlock  FontFamily="Segoe MDL2 Assets"
                        Text="&#xE787;"
                        FontSize="14"
                        VerticalAlignment="Center"/>
        </ToggleButton>
        <Popup IsOpen="{Binding ElementName=CalendarButton, Path=IsChecked}"
               PlacementTarget="{Binding ElementName=CalendarButton}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border BorderBrush="LightGray" BorderThickness="1" Background="White">
                <Calendar x:Name="calView" SelectedDatesChanged="calView_SelectedDatesChanged"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
